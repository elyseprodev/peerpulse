# ─────────────────────────────────────────────────────────────────────────────
# PeerPulse environment template — copy to `.env.local` and fill in.
# NEVER commit real credentials. Everything in this file ships to the browser,
# so only public Firebase Web SDK config belongs here.
# ─────────────────────────────────────────────────────────────────────────────

# Backend adapter: `local` (in-browser demo backend, no cloud project needed)
# or `firebase` (Firebase Auth + Firestore + Cloud Functions).
VITE_BACKEND_MODE=local

# ── Firebase Web SDK config (Project settings → Your apps → SDK setup) ───────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3 site key). Required in production.
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG=false

# Cloud Functions region (must match functions/src/config.ts)
VITE_FUNCTIONS_REGION=europe-west1

# ── Firebase Cloud Messaging (Web Push / VAPID public key) ───────────────────
VITE_FCM_VAPID_KEY=

# ── WebRTC ICE configuration ────────────────────────────────────────────────
# Comma-separated STUN URLs. Public STUN is fine for development.
VITE_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN is required for symmetric NAT / restrictive corporate networks.
# Choose ONE of the following:
#
# (a) Static TURN credentials — acceptable for local development only.
# VITE_WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# VITE_WEBRTC_TURN_USERNAME=
# VITE_WEBRTC_TURN_CREDENTIAL=
#
# (b) RECOMMENDED: leave (a) empty. The app calls the `getTurnCredentials`
#     Cloud Function, which mints short-lived HMAC credentials server-side so
#     no long-lived TURN secret ever reaches the browser.
VITE_TURN_CREDENTIALS_ENDPOINT=callable

# Extra hostnames Vite may serve from (comma separated). `true`-style wildcards
# are handled in vite.config.ts; override for locked-down deployments.
VITE_ALLOWED_HOSTS=
